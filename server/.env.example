# Di luar kantor: jalankan tunnel SSH terlebih dahulu.
PGHOST=127.0.0.1
PGPORT=15433
PGDATABASE=db_magang
PGUSER=magang
PGPASSWORD=""
PGSSLMODE=prefer
# Di jaringan kantor: PGHOST=192.168.100.10 dan PGPORT=5432.
# Schema iph_batu dikunci di konfigurasi aplikasi; jangan memakai DATABASE_URL lama.

PORT=5011
CLIENT_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Diisi hanya untuk inisialisasi akun pertama (npm run db:bootstrap).
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_NAME="Administrator TPID"
INITIAL_ADMIN_PASSWORD=""

# n8n + existing WAHA: fill after the meeting workflow is configured.
WHATSAPP_AUTOMATION_ENABLED=false
N8N_WHATSAPP_WEBHOOK_URL=""
N8N_WHATSAPP_TOKEN=""
# Alamat frontend yang dapat dibuka dari ponsel peserta (domain atau IP kantor).
# Jangan memakai localhost untuk link yang dikirim melalui WhatsApp.
PUBLIC_APP_URL=""
