generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["iph_batu"]
}

// ─── Auth ───────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  emailNorm String   @unique // email lowercase for case-insensitive lookup
  password  String
  role      String   @default("petugas") // admin | petugas | tamu
  status    String   @default("pending") // pending | aktif | nonaktif
  instansiId String?
  instansi  Instansi? @relation(fields: [instansiId], references: [id], onDelete: SetNull)
  nip       String?
  phone     String?
  bio       String?
  lastLoginAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions Session[]
  pegawai  Pegawai?
  rekaps   Rekap[]   @relation("RekapCreatedBy")
  @@schema("iph_batu")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String
  device    String?
  ip        String?
  userAgent String?
  lastActiveAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("iph_batu")
}

// ─── Audit log ────────────────────────────────────────────────────────────
// Jejak aksi sensitif (hapus akun, kelola pegawai, nonaktifkan komoditas,
// hapus rekap). actorId sengaja TIDAK memakai relasi FK supaya barisnya tetap
// tersimpan walau akun pelakunya dihapus.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  aksi      String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@schema("iph_batu")
}

// ─── Master data ────────────────────────────────────────────────────────
model Instansi {
  id     String @id @default(cuid())
  nama   String @unique
  createdAt DateTime @default(now())

  users User[]
  pegawais Pegawai[]
  @@schema("iph_batu")
}

model Komoditas {
  id        String   @id @default(cuid())
  nama      String   @unique
  namaNorm  String   @unique // lowercase for case-insensitive dedupe
  unit      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  details RekapDetail[]
  @@schema("iph_batu")
}

model Pegawai {
  id          String   @id @default(cuid())
  name        String
  nip         String   @unique
  instansiId  String?
  instansi    Instansi? @relation(fields: [instansiId], references: [id], onDelete: SetNull)
  instansiSub String?
  peran       String
  peranIcon   String?
  email       String?
  phone       String?
  status      String   @default("aktif") // aktif | nonaktif | cuti
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  petugasRapat PetugasRapat[]
  notulensi    Notulensi[]

  @@index([status])
  @@schema("iph_batu")
}

// ─── Rekap IPH ──────────────────────────────────────────────────────────
model Rekap {
  id           String   @id @default(cuid())
  tahun        Int
  bulan        Int // 1..12
  mingguIndeks Int // 1..5
  indikator    Float
  status       String   @default("submitted") // draft | submitted
  createdById  String
  createdBy    User     @relation("RekapCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  details RekapDetail[]

  @@unique([tahun, bulan, mingguIndeks])
  @@index([createdById])
  @@schema("iph_batu")
}

model RekapDetail {
  id          String    @id @default(cuid())
  rekapId     String
  rekap       Rekap     @relation(fields: [rekapId], references: [id], onDelete: Cascade)
  komoditasId String
  komoditas   Komoditas @relation(fields: [komoditasId], references: [id])
  nilai       Float // andil (persen poin)
  isFluktuasi Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([rekapId])
  @@schema("iph_batu")
}

// ─── Modul rapat & notulensi ─────────────────────────────────────────────
model Rapat {
  id          String   @id @default(cuid())
  topik       String
  tanggal     DateTime // saat rapat dimulai
  lokasi      String?
  tautanRapat String?
  notulensiKey String? @unique
  notulensiInvitedAt DateTime?
  catatan     String?
  status      String   @default("terjadwal") // terjadwal | selesai | dibatalkan
  createdById String   // tanpa FK relasi; bareng AuditLog, tahan dihapus
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notificationRevision Int @default(1)

  petugas   PetugasRapat[]
  notulensi Notulensi?
  notifications WhatsAppNotification[]

  @@index([createdById])
  @@index([tanggal])
  @@schema("iph_batu")
}

model WhatsAppNotification {
  id                String @id @default(cuid())
  rapatId           String
  rapat             Rapat @relation(fields: [rapatId], references: [id], onDelete: Cascade)
  pegawaiId         String
  kind              String
  revision          Int
  recipientName     String
  phone             String?
  message           String
  scheduledAt       DateTime
  expiresAt         DateTime
  status            String @default("pending")
  attempts          Int @default(0)
  startedAt         DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([rapatId, pegawaiId, kind, revision])
  @@index([status, scheduledAt])
  @@schema("iph_batu")
}

model PetugasRapat {
  id        String  @id @default(cuid())
  rapatId   String
  rapat     Rapat   @relation(fields: [rapatId], references: [id], onDelete: Cascade)
  pegawaiId String
  pegawai   Pegawai @relation(fields: [pegawaiId], references: [id], onDelete: Cascade)
  peran     String  @default("peserta") // notulis | peserta
  createdAt DateTime @default(now())

  @@unique([rapatId, pegawaiId])
  @@schema("iph_batu")
}

model Notulensi {
  id               String   @id @default(cuid())
  rapatId          String   @unique
  rapat            Rapat    @relation(fields: [rapatId], references: [id], onDelete: Cascade)
  isi              String
  notulisPegawaiId String
  notulis          Pegawai  @relation(fields: [notulisPegawaiId], references: [id])
  submittedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@schema("iph_batu")
}

model AppSetting {
  id        String @id
  value     String
  updatedAt DateTime @updatedAt
  @@schema("iph_batu")
}
